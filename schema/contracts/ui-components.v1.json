{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema:ui-components:v1",
  "title": "UI Components",
  "description": "Output of ui-builder — a list of declared components with props, plus optional theme.",
  "type": "object",
  "additionalProperties": false,
  "required": ["components"],
  "properties": {
    "theme": { "type": "string" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "props"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "props": { "type": "object" }
        }
      }
    }
  }
}
