{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schema:schema-recommendation:v2",
  "title": "Schema Recommendation v2",
  "description": "Output of schema-review. v2 adds index strategies + anti-patterns; the absence of these on v1 is what broke downstream consumers in the original incident.",
  "type": "object",
  "additionalProperties": false,
  "required": ["collection", "shape", "indexes", "anti_patterns"],
  "properties": {
    "collection": { "type": "string", "minLength": 1 },
    "shape": {
      "type": "object",
      "description": "Document shape. Free-form by design; downstream code-gen handles field-level concerns."
    },
    "indexes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fields", "strategy"],
        "properties": {
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "strategy": {
            "type": "string",
            "enum": ["compound", "partial", "vector", "single"]
          },
          "rationale": { "type": "string" }
        }
      }
    },
    "anti_patterns": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
