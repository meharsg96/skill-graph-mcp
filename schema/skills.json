    {
      "_id": "skill:leafygreen-ui",
      "name": "LeafyGreen UI Builder",
      "description": "MongoDB's official LeafyGreen design system as a parameterized skill. Consumes ui_requirements directly (no upstream chain \u2014 design-system-bound, not data-backed). Single canonical 'default' tenant carries the full design system; this skill does NOT support per-deployment overrides like client-a/client-b \u2014 for those, use skill:ui-builder. Pairs with skill:react-test-writer for tested LeafyGreen artifacts. CHOOSE THIS when the UI is design-system-bound (Atlas-style, no schema dependency); choose skill:ui-builder when the UI is data-backed (needs schema and queries first).",
      "version": "1.0.0",
      "lifecycle": "active",
      "input": {
        "type": "ui_requirements",
        "schema": "schema:ui-requirements:v1"
      },
      "output": {
        "type": "react_artifact",
        "schema": "schema:react-artifact:v1"
      },
      "dependencies": [],
      "dependency_constraints": {},
      "parameter_sources": [
        "params:leafygreen-ui:default"
      ],
      "domain_fields": {
        "design_system": "leafygreen",
        "design_system_source": "https://github.com/mongodb/leafygreen-ui",
        "artifact_format": "react_jsx",
        "rendering_strategy": "css_custom_properties",
        "rendering_note": "LeafyGreen uses Emotion CSS-in-JS which is unavailable in artifact environments. This skill encodes the full design system as CSS custom properties and Tailwind-compatible patterns.",
        "font_fallback_note": "Euclid Circular A is not available on CDN. The system font stack matches its metrics.",
        "accessibility_rules": [
          {
            "id": "no-green-base-on-white",
            "rule": "green.base (#00ED64) must NEVER be used for text on white",
            "reason": "fails WCAG AA contrast",
            "use_instead": "green.dark2 (#00684A)"
          }
        ]
      },
      "skill_path": "skills/leafygreen/SKILL.md"
    },
