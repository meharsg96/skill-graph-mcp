# Copy to .env and adjust. .env is gitignored.

# MongoDB connection string used by server.py and scripts/.
MONGODB_URI=mongodb://localhost:27017

# Transport mode for server.py.
# "stdio" (default) — for Claude Code and MCP hosts that spawn the process.
# "streamable-http" — for Claude web remote connectors and other HTTP clients.
#   Start a tunnel alongside: ngrok http 8000
#   Then enter the tunnel URL in Claude web > Connectors > Add custom connector.
# MCP_TRANSPORT=streamable-http
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# SESSION_ID is set at runtime by scripts/run_session.sh — not stored here.

# OpenRouter API key — used by scripts/extract_fact_summary.py (Layer 2 fact extraction).
# OPENROUTER_MODEL defaults to anthropic/claude-haiku-4-5 if not set.
# OPENROUTER_API_KEY=sk-or-...

# Voyage AI API key — used by scripts/seed_constraint_embeddings.py (Layer 2 embeddings).
# Get from console.voyageai.com — project: skill-graph
# VOYAGE_API_KEY=pa-...
