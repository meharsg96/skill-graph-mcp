# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Environments
.env
venv/
.venv/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Local-only working notes, plans, drafts — never committed
notes/

# Generated demo artifacts (e.g. R1 outputs from Claude Code)
login-*.html
*-artifact.html

# Local-overlay skills (v2.5+). Defense-in-depth: the canonical location
# is OUTSIDE the repo entirely (~/.skill-graph-local/), so these patterns
# are belt-and-suspenders for the case where local content is accidentally
# put inside the repo working tree.
schema/local/
skills/local/
*-local.json
*.local.json
.skill-graph-local/

# v2.11+: Claude Code session state and emit_hooks output. The hooks
# fragment is reproducible from db.constraints + scripts/emit_hooks.py,
# so committing it would just churn whenever the constraint set changes.
.claude/

# Blog presentation working set (svg/pptx/build artifacts) — not part of
# the codebase, not committed.
decks/
