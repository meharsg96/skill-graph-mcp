# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Environments
.env
venv/
.venv/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Local-only working notes, plans, drafts — never committed
notes/

# Generated demo artifacts (e.g. R1 outputs from Claude Code)
login-*.html
*-artifact.html

# Local-overlay skills (v2.5+). Defense-in-depth: the canonical location
# is OUTSIDE the repo entirely (~/.skill-graph-local/), so these patterns
# are belt-and-suspenders for the case where local content is accidentally
# put inside the repo working tree.
schema/local/
skills/local/
*-local.json
*.local.json
.skill-graph-local/
